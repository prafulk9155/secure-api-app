MONGO_URI=mongodb://127.0.0.1:27017/hmac_db
API_PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Express session (login) cookie
SESSION_SECRET=change-me
COOKIE_SECURE=false

# Web request signing. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random value is used per process (sessions reset on restart).
WEB_TOKEN_SECRET=
HMAC_SECRET=

# enforce = block bad requests; log = let them through but record wouldBlock=true
GUARD_MODE=enforce

# Which proxies may set X-Forwarded-For (express "trust proxy" value)
TRUST_PROXY=loopback

# Optional: require x-admin-key for /api/admin/logs (otherwise localhost only)
ADMIN_KEY=

# Optional tuning (defaults shown)
# WEB_SESSION_TTL_SEC=600
# SIG_TS_WINDOW_SEC=60
# WEB_RATE_PER_MIN=60
# IP_RATE_PER_MIN=120
# SESSION_ISSUE_PER_MIN=20
# REJECTION_ALERT_THRESHOLD=5
